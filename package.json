{
  "name": "cairul",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "run:mcp": "node apps/mcp/dist/index.js",
    "test": "turbo run test",
    "lint": "prettier --check . && eslint \"*.mjs\" scripts \"packages/**/*.mjs\" && turbo run lint",
    "format": "prettier --write .",
    "check": "pnpm lint && turbo run build test",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "@openapitools/openapi-generator-cli": "2.42.2"
  },
  "license": "Apache-2.0"
}
